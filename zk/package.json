{
  "name": "privface-zk-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node scripts/test.mjs",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "train:ml": "python3 ml/train.py",
    "setup:ml": "node scripts/setup-ml.mjs",
    "prepare:ml-browser": "node scripts/prepare-ml-browser.mjs",
    "test:ml": "node scripts/test-ml.mjs",
    "train:fisher": "python3 ml/train_fisher.py",
    "test:m2": "python3 -m unittest discover -s ml -p test_m2.py",
    "check:m2": "python3 ml/check_m2.py"
  },
  "dependencies": {
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "8.21.0"
    },
    "jsonpath": {
      "underscore": "1.13.8"
    }
  }
}
