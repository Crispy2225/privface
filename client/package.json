{
  "name": "isl-face-auth-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/*.test.ts tests/face-precheck.test.mjs",
    "test:zkml-browser": "node tests/zkml-smoke.mjs",
    "prepare:vision": "node scripts/prepare-vision.mjs && node scripts/prepare-recognition.mjs",
    "predev": "npm run prepare:vision && npm run prepare:study",
    "prebuild": "npm run prepare:vision && npm run prepare:study",
    "audit:quantization": "node scripts/audit-quantization.mjs",
    "evaluate:matching": "node --experimental-strip-types scripts/evaluate-matching.mjs",
    "prepare:study": "node scripts/quantize-recognition.mjs public/vision/recognition-int8",
    "benchmark:zkml": "node tests/zkml-benchmark.mjs",
    "test:face-camera": "node tests/m4-smoke.mjs",
    "test:dashboard": "node tests/dashboard-smoke.mjs"
  },
  "overrides": {
    "node-fetch": "2.7.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "face-api.js": "0.22.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
